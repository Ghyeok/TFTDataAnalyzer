<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements">
    <ui:Style src="TftDataAnalyzerWindow.uss" />
    <ui:VisualElement name="analyzer-shell" class="tft-analyzer-shell">
        <editor:Toolbar class="tft-tab-toolbar">
            <ui:Button name="data-tab-button" text="데이터 관리" />
            <ui:Button name="collection-tab-button" text="경기 수집" />
            <ui:Button name="analysis-tab-button" text="과거 집계 분석" />
            <ui:Button name="about-tab-button" text="정책 안내" />
        </editor:Toolbar>
        <ui:VisualElement class="tft-tab-content">
            <ui:VisualElement name="data-tab" class="tft-tab tft-data-tab">
                <ui:ScrollView name="data-scroll" class="tft-data-scroll" mode="Vertical">
                    <ui:VisualElement class="tft-data-content">
                        <ui:Label text="정적 데이터 관리" class="tft-tab-title" />
                        <ui:Label text="세트·TFT 패치·원본 게임 버전과 출처별로 카탈로그를 가져오고 비교합니다." class="tft-wrapped-text" />
                        <ui:VisualElement name="import-inputs" class="tft-data-section">
                            <ui:TextField name="set-id" label="세트 ID" class="tft-data-field" />
                            <ui:IntegerField name="set-number" label="세트 번호" class="tft-data-field" />
                            <ui:TextField name="tft-patch" label="TFT 패치" class="tft-data-field" />
                            <ui:TextField name="source-version" label="원본 게임 버전" class="tft-data-field" />
                            <ui:Toggle name="communitydragon-toggle" label="CommunityDragon 보충 사용" />
                            <ui:Label text="보충 자료 사용은 가져올 때마다 선택합니다. 가져오기 전에 대상과 저장 위치를 확인합니다." class="tft-wrapped-text" />
                        </ui:VisualElement>
                        <ui:VisualElement class="tft-data-actions">
                            <ui:Button name="check-updates-button" text="원본 버전 확인" />
                            <ui:Button name="import-button" text="카탈로그 가져오기" />
                            <ui:Button name="cancel-button" text="작업 취소" />
                        </ui:VisualElement>
                        <ui:Label name="data-status" class="tft-data-status tft-wrapped-text" />
                        <ui:Label name="startup-version-notice" class="tft-wrapped-text tft-tab-hidden" />
                        <ui:Foldout text="사용 가능한 원본 버전" value="false">
                            <ui:Label name="available-versions" class="tft-wrapped-text" />
                        </ui:Foldout>
                        <ui:Label text="로컬 카탈로그" class="tft-tab-title tft-data-section" />
                        <ui:Label text="행을 선택하면 이 창의 활성 카탈로그로 사용합니다. 검증에 실패한 행은 선택할 수 없습니다." class="tft-wrapped-text" />
                        <ui:Label name="catalog-empty-state" text="아직 로컬 카탈로그가 없습니다. 가져올 패치를 입력해 주세요." class="tft-wrapped-text" />
                        <ui:ListView name="catalog-list" class="tft-catalog-list" />
                        <ui:Label name="active-catalog" class="tft-wrapped-text" />
                        <ui:Foldout name="catalog-browser" text="카탈로그 내용 탐색" value="false" class="tft-data-section">
                            <ui:Label name="browser-catalog" class="tft-wrapped-text" />
                            <ui:Label text="로컬 정적 자료입니다. 수록 여부가 이 패치의 실제 경기 등장이나 증강 통계 허용을 뜻하지 않습니다." class="tft-wrapped-text" />
                            <ui:DropdownField name="browser-kind" label="종류" class="tft-data-field" />
                            <ui:TextField name="browser-search" label="이름 또는 ID 검색" class="tft-data-field" />
                            <ui:Label name="browser-status" class="tft-wrapped-text" />
                            <ui:ListView name="browser-results" class="tft-browser-results" />
                            <ui:VisualElement class="tft-data-actions">
                                <ui:Button name="browser-previous" text="이전 페이지" />
                                <ui:Button name="browser-next" text="다음 페이지" />
                            </ui:VisualElement>
                            <ui:Label name="browser-selection-notice" text="목록에서 항목을 선택하면 상세 내용을 볼 수 있습니다." class="tft-wrapped-text" />
                            <ui:VisualElement name="browser-details" class="tft-tab-hidden">
                                <ui:Image name="browser-icon" class="tft-browser-icon" />
                                <ui:Label name="browser-icon-missing" text="아이콘 없음" class="tft-wrapped-text" />
                                <ui:Label name="browser-detail-text" class="tft-wrapped-text" />
                            </ui:VisualElement>
                        </ui:Foldout>
                        <ui:Label text="카탈로그 변경 비교" class="tft-tab-title tft-data-section" />
                        <ui:DropdownField name="diff-before" label="이전" class="tft-data-field" />
                        <ui:DropdownField name="diff-after" label="이후" class="tft-data-field" />
                        <ui:Button name="compare-button" text="선택한 카탈로그 비교" />
                        <ui:Label name="diff-empty-state" class="tft-wrapped-text" />
                        <ui:VisualElement name="catalog-diff" class="tft-data-section" />
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement name="collection-tab" class="tft-tab tft-data-tab tft-tab-hidden">
                <ui:ScrollView name="collection-scroll" class="tft-data-scroll" mode="Vertical">
                    <ui:VisualElement class="tft-data-content">
                        <ui:Label text="과거 경기 수집" class="tft-tab-title" />
                        <ui:Label name="collection-catalog" class="tft-wrapped-text" />
                        <ui:Label name="collection-credentials" class="tft-wrapped-text" />
                        <ui:Button name="collection-configuration-check" text="환경 설정 확인" />
                        <ui:Label text="API 키와 시드는 환경 설정에서만 읽으며 값은 화면에 표시하거나 저장하지 않습니다. 사용자 제공 시드만 조회하며 참가자로 확장하지 않습니다." class="tft-wrapped-text" />
                        <ui:VisualElement name="collection-inputs" class="tft-data-section">
                            <ui:DropdownField name="collection-platform" label="플랫폼" class="tft-data-field" />
                            <ui:IntegerField name="collection-queue" label="큐 ID" class="tft-data-field" />
                            <ui:DropdownField name="collection-tier" label="티어 기록 라벨" class="tft-data-field" />
                            <ui:Label text="티어는 호출자가 지정하는 기록 라벨이며 실제 랭크를 검증하지 않습니다." class="tft-wrapped-text" />
                            <ui:IntegerField name="collection-maximum" label="상세 시도 상한" class="tft-data-field" />
                            <ui:Label text="1–1,000개의 고유 경기 상세 조회를 시도합니다. 저장 성공 수의 상한을 목표로 반복하지 않습니다. ID 탐색은 최대 10페이지입니다." class="tft-wrapped-text" />
                        </ui:VisualElement>
                        <ui:VisualElement class="tft-data-actions">
                            <ui:Button name="collection-start" text="조건 확인 후 수집" />
                            <ui:Button name="collection-cancel" text="수집 취소" />
                        </ui:VisualElement>
                        <ui:Label name="collection-status" class="tft-data-status tft-wrapped-text" />
                        <ui:Label name="collection-counts" class="tft-wrapped-text" />
                        <ui:Label name="collection-rate-limit" class="tft-wrapped-text" />
                        <ui:Label name="collection-cancellation" class="tft-wrapped-text" />
                        <ui:Label name="collection-scan-limit" class="tft-wrapped-text" />
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement name="analysis-tab" class="tft-tab tft-data-tab tft-tab-hidden">
                <ui:ScrollView name="analysis-scroll" class="tft-data-scroll" mode="Vertical">
                    <ui:VisualElement class="tft-data-content">
                        <ui:Label text="과거 관측 결과 분석" class="tft-tab-title" />
                        <ui:Label name="analysis-catalog" class="tft-wrapped-text" />
                        <ui:Label text="로컬 새로고침은 익명 관측에서 집계를 재생성합니다. 필터 변경은 현재 결과만 좁히며 네트워크를 사용하지 않습니다." class="tft-wrapped-text" />
                        <ui:IntegerField name="analysis-minimum-samples" label="최소 표본 수" value="100" class="tft-data-field" />
                        <ui:Label name="analysis-minimum-status" class="tft-wrapped-text" />
                        <ui:VisualElement class="tft-data-actions">
                            <ui:Button name="analysis-refresh" text="로컬 집계 새로고침" />
                            <ui:Button name="analysis-cancel" text="새로고침 취소" />
                        </ui:VisualElement>
                        <ui:Label name="analysis-status" class="tft-data-status tft-wrapped-text" />
                        <ui:Label name="analysis-period" class="tft-wrapped-text" />
                        <ui:VisualElement name="analysis-filters" class="tft-data-section">
                            <ui:DropdownField name="analysis-region" label="지역" class="tft-data-field" />
                            <ui:DropdownField name="analysis-queue" label="큐" class="tft-data-field" />
                            <ui:DropdownField name="analysis-tier" label="티어 기록 라벨" class="tft-data-field" />
                            <ui:DropdownField name="analysis-unit" label="기물" class="tft-data-field" />
                            <ui:DropdownField name="analysis-trait" label="활성 시너지" class="tft-data-field" />
                            <ui:DropdownField name="analysis-item" label="장착 아이템" class="tft-data-field" />
                            <ui:DropdownField name="analysis-augment" label="증강" class="tft-data-field" />
                            <ui:Label text="조건은 같은 조합 안에서 모두 일치해야 합니다. 상대 비교는 어느 한 조합이 모든 조건을 충족하면 표시합니다. 전체는 서로 다른 범위의 행을 합산하지 않습니다. 티어는 수집 당시의 기록 라벨입니다." class="tft-wrapped-text" />
                        </ui:VisualElement>
                        <ui:Label text="최종 관측 조합 · 표본은 참가자 관측 수" class="tft-tab-title" />
                        <ui:VisualElement name="analysis-rows" />
                        <ui:VisualElement class="tft-data-actions">
                            <ui:Button name="analysis-rows-previous" text="이전" />
                            <ui:Label name="analysis-rows-page" />
                            <ui:Button name="analysis-rows-next" text="다음" />
                        </ui:VisualElement>
                        <ui:Label name="analysis-pairwise-heading" text="상대 배치 우위율" tooltip="같은 로비의 최종 순위 비교이며 실제 전투 승률이 아닙니다." class="tft-tab-title" />
                        <ui:Label text="같은 로비의 최종 순위 비교이며 실제 전투 승률이 아닙니다. 표본은 비교 가능한 로비 수입니다. A가 B보다 높은 최종 순위를 기록한 비율을 표시합니다." class="tft-wrapped-text" />
                        <ui:VisualElement name="analysis-pairs" />
                        <ui:VisualElement class="tft-data-actions">
                            <ui:Button name="analysis-pairs-previous" text="이전" />
                            <ui:Label name="analysis-pairs-page" />
                            <ui:Button name="analysis-pairs-next" text="다음" />
                        </ui:VisualElement>
                        <ui:Button name="analysis-export" text="필터 결과 전체를 개인 연구용 CSV로 저장" />
                        <ui:Label name="analysis-export-status" class="tft-wrapped-text" />
                        <ui:Label text="CSV에는 현재 필터에 맞는 모든 페이지의 허용된 지표만 포함합니다. 비율 차단 시 분자·분모·비율·신뢰구간을 비웁니다." class="tft-wrapped-text" />
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>
            <ui:VisualElement name="about-tab" class="tft-tab tft-data-tab tft-tab-hidden" />
        </ui:VisualElement>
        <ui:Label name="historical-data-disclaimer" class="tft-disclaimer" text="과거 관측 결과이며 전투 예측이나 플레이 권고가 아닙니다." />
    </ui:VisualElement>
</ui:UXML>
