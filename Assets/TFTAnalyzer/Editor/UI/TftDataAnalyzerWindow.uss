.tft-analyzer-tree,
.tft-analyzer-shell,
.tft-tab-content {
    flex-grow: 1;
    min-height: 0;
}

.tft-analyzer-shell Label {
    white-space: normal;
}

.tft-tab-toolbar {
    flex-wrap: wrap;
    flex-shrink: 0;
    height: auto;
}

.tft-tab-toolbar Button {
    flex-grow: 1;
    padding-top: 5px;
    padding-bottom: 5px;
}

.tft-tab-selected {
    -unity-font-style: bold;
    border-bottom-width: 2px;
    border-bottom-color: var(--unity-colors-button-text);
}

.tft-tab {
    padding: 12px;
}

.tft-data-tab {
    flex-grow: 1;
    min-height: 0;
    padding: 0;
}

.tft-data-scroll {
    flex-grow: 1;
    min-height: 0;
}

.tft-data-content {
    padding: 12px;
}

.tft-data-section {
    margin-top: 12px;
    margin-bottom: 8px;
}

.tft-data-field {
    margin-bottom: 5px;
    min-width: 0;
}

.tft-data-field > .unity-base-field__label {
    min-width: 110px;
    max-width: 110px;
    white-space: normal;
}

.tft-data-actions {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 6px;
}

.tft-data-actions Button {
    flex-grow: 1;
    min-height: 25px;
}

.tft-data-status {
    margin-top: 5px;
    margin-bottom: 10px;
}

.tft-catalog-list {
    height: 230px;
    flex-shrink: 0;
    margin-top: 6px;
    margin-bottom: 8px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: var(--unity-colors-button-border);
    border-bottom-color: var(--unity-colors-button-border);
}

.tft-catalog-row {
    padding: 8px 5px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-button-border);
}

.tft-catalog-invalid {
    opacity: 0.6;
}

.tft-wrapped-text {
    white-space: normal;
    min-width: 0;
}

.tft-analysis-row {
    padding: 9px 6px;
    margin-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-button-border);
}

.tft-analysis-row > Label {
    margin-bottom: 3px;
}

#analysis-rows-page,
#analysis-pairs-page {
    align-self: center;
    margin-left: 8px;
    margin-right: 8px;
}

.tft-tab-title {
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.tft-tab-hidden {
    display: none;
}

.tft-disclaimer {
    flex-shrink: 0;
    padding: 10px 12px;
    border-top-width: 1px;
    border-top-color: var(--unity-colors-button-border);
}
